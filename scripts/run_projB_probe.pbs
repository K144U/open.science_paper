#!/bin/bash
# Project B - Phase-2 mechanistic probe (probe.py) on a trained checkpoint.
# ARGS = colon-separated CLI args (':' -> space; NO commas -> qsub -v eats them).
#   qsub -v ARGS="--ckpt:runs/s5_logc2_curr32/ckpt_final.pt:--task:s5:--n:16:--out:runs/s5_logc2_curr32/probe_n16.json" \
#        scripts/run_projB_probe.pbs
#PBS -q gpu
# NOTE 2026-08-19: ncpus=1, measured, not guessed.  train.py/eval_loops.py
# have no DataLoader and no worker processes (batches are generated inline by
# single-threaded NumPy).  Measured on jiit-gpu01: each python process sits at
# 97.8% CPU, i.e. under ONE core, with its extra threads idle CUDA plumbing.
# The GPU node runs at 95/96 cores RESERVED but only ~41 busy, so cpus are the
# scarce resource purely by reservation; every core we over-request is a slot
# we cannot use.  ncpus=2 wasted half our allocation.  Do not raise this.
#PBS -l select=1:ncpus=1
#PBS -l walltime=3:00:00
#PBS -N projB_probe
#PBS -j oe
#PBS -o ${REPO}/pbs_logs/projB_probe.pbs.out

set -uo pipefail
REPO=${REPO:-$(pwd)}
cd "$REPO"; mkdir -p pbs_logs

source /cm/shared/apps/anaconda3/etc/profile.d/conda.sh
conda activate "$REPO/.conda/envs/loopedlm"
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
export PYTHONNOUSERSITE=1 TOKENIZERS_PARALLELISM=false
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export MIN_FREE_MIB="${MIN_FREE_MIB:-8000}"

ARGS="${ARGS:?set ARGS=colon-separated probe.py args}"
export CUDA_VISIBLE_DEVICES=$(bash scripts/pick_gpu.sh 1)
echo "host=$(hostname) gpu=$CUDA_VISIBLE_DEVICES"
nvidia-smi --query-gpu=index,memory.free,utilization.gpu --format=csv,noheader

NAME=$(echo "$ARGS" | sed -n 's/.*--out \([^ ]*\).*/\1/p' | tr '/' '_')
python code/projB/probe.py $(echo "$ARGS" | tr ':' ' ') 2>&1 \
    | tee "pbs_logs/${NAME:-projB_probe}.log"
echo "===== probe done ====="
